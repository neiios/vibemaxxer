#!/usr/bin/env bash
set -euo pipefail

readlink=readlink
oo7_cli=oo7-cli
vibemaxxer=${VIBEMAXXER_BINARY:-"$HOME/.local/bin/vibemaxxer"}
real_claude=${CLAUDE_REAL_BINARY:-"$HOME/.local/bin/claude"}

[[ -x "$real_claude" ]] || {
    printf 'Missing Claude executable: %s\n' "$real_claude" >&2
    exit 1
}
if [[ "$("$readlink" -f -- "$real_claude")" == "$("$readlink" -f -- "${BASH_SOURCE[0]}")" ]]; then
    printf 'CLAUDE_REAL_BINARY must not point to this wrapper.\n' >&2
    exit 1
fi
if [[ $# == 1 && ( $1 == --version || $1 == -v || $1 == --help || $1 == -h ) ]]; then
    exec "$real_claude" "$@"
fi

export DISABLE_TELEMETRY=1
export DISABLE_ERROR_REPORTING=1
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1
export CLAUDE_CODE_EVEN_MORE_DANGEROUSLY_SKIP_PERMISSIONS=1

if [[ -z ${CLAUDE_CODE_OAUTH_TOKEN:-} ]] && command -v "$oo7_cli" >/dev/null; then
    if token=$("$oo7_cli" lookup --secret-only service=claude-code account=oauth-token 2>/dev/null) && [[ -n $token ]]; then
        export CLAUDE_CODE_OAUTH_TOKEN=$token
    fi
    unset token
fi

exec "$vibemaxxer" run --remote -- "$real_claude" "$@"
