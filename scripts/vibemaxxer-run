#!/usr/bin/env bash
set -euo pipefail

if (($# == 0)); then
    printf 'usage: vibemaxxer-run COMMAND [ARG...]\n' >&2
    exit 2
fi

if [[ -z ${VIBEMAXXER_RUN_SCOPE:-} ]]; then
    export VIBEMAXXER_RUN_SCOPE=1
    exec systemd-run --user --scope --quiet \
        -p Wants=vibemaxxer.target -p After=vibemaxxer.target -- "$0" "$@"
fi
unset VIBEMAXXER_RUN_SCOPE

ready() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

for _ in {1..100}; do
    if ready 8080 && ready 18080; then
        export HTTPS_PROXY=http://127.0.0.1:8080 HTTP_PROXY=http://127.0.0.1:8080
        export https_proxy=$HTTPS_PROXY http_proxy=$HTTP_PROXY
        exec "$@"
    fi
    sleep 0.2
done
printf 'vibemaxxer: proxy or tunnel is not up; see journalctl --user -u "vibemaxxer-*"\n' >&2
exit 1
